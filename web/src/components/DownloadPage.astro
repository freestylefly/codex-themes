---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  GITHUB_REPO_URL,
  MAC_ARM64_DMG_URL,
  MAC_ARM64_ZIP_URL,
  MAC_X64_DMG_URL,
  MAC_X64_ZIP_URL,
  WINDOWS_X64_EXE_URL,
} from "../config";
import type { Locale } from "../lib/i18n";

const { locale } = Astro.props as { locale: Locale };
const description =
  locale === "zh"
    ? "下载适用于 Apple 芯片 Mac、Intel Mac 和 Windows x64 的最新版 Codex Themes。"
    : "Download the latest Codex Themes for Apple silicon Macs, Intel Macs, and Windows x64.";
---

<BaseLayout locale={locale} title={locale === "zh" ? "下载" : "Download"} description={description}>
  <section class="download-page-hero section-shell">
    <div class="eyebrow">CODEX THEMES · LATEST BETA</div>
    <h1>{locale === "zh" ? "下载，然后打开一个更有趣的 Codex。" : "Download a more personal Codex workspace."}</h1>
    <p>{description}</p>
    <div class="download-card-list">
      <div class="download-card">
        <div class="download-card-main">
          <div class="platform-mark">macOS</div>
          <div>
            <h2>{locale === "zh" ? "Apple 芯片版" : "Apple silicon"}</h2>
            <p>M1 / M2 / M3 / M4 / M5 · macOS 13+</p>
          </div>
        </div>
        <div class="download-card-actions">
          <a class="button button-blue" href={MAC_ARM64_DMG_URL}>{locale === "zh" ? "下载 DMG" : "Download DMG"}</a>
          <a class="text-link" href={MAC_ARM64_ZIP_URL}>{locale === "zh" ? "下载 ZIP" : "Download ZIP"}</a>
        </div>
      </div>
      <div class="download-card">
        <div class="download-card-main">
          <div class="platform-mark">macOS</div>
          <div>
            <h2>{locale === "zh" ? "Intel 芯片版" : "Intel"}</h2>
            <p>Intel x64 · macOS 13+</p>
          </div>
        </div>
        <div class="download-card-actions">
          <a class="button button-blue" href={MAC_X64_DMG_URL}>{locale === "zh" ? "下载 DMG" : "Download DMG"}</a>
          <a class="text-link" href={MAC_X64_ZIP_URL}>{locale === "zh" ? "下载 ZIP" : "Download ZIP"}</a>
        </div>
      </div>
      <div class="download-card download-card--preview">
        <div class="download-card-main">
          <div class="platform-mark">Windows</div>
          <div>
            <div class="download-preview-pill">{locale === "zh" ? "预览版" : "Preview"}</div>
            <h2>Windows x64</h2>
            <p>{locale === "zh" ? "Windows 11 · NSIS 安装程序" : "Windows 11 · NSIS installer"}</p>
          </div>
        </div>
        <div class="download-card-actions">
          <a class="button button-blue" href={WINDOWS_X64_EXE_URL}>{locale === "zh" ? "下载 EXE" : "Download EXE"}</a>
        </div>
      </div>
    </div>
    <p class="availability-note">
      {locale === "zh"
        ? "Windows 预览版尚未配置代码签名，首次安装可能出现 SmartScreen 提示。请确认安装包来自本官网或 GitHub Release。"
        : "The Windows preview is currently unsigned, so SmartScreen may ask for confirmation. Download only from this website or the GitHub Release."}
    </p>
  </section>

  <section class="install-guide section-shell">
    <div class="section-kicker">{locale === "zh" ? "安装与更新" : "INSTALL & UPDATE"}</div>
    <div class="install-guide-grid">
      <h2>
        {locale === "zh"
          ? "先把 Codex 和 Codex Themes 都更新到最新版"
          : "Keep both Codex and Codex Themes up to date"}
      </h2>
      <div>
        <ol>
          <li>
            {locale === "zh"
              ? "先从官方渠道安装或升级到最新版 ChatGPT / Codex 桌面应用，并确认可以进入 Codex 模式。"
              : "First install or update the official ChatGPT / Codex desktop app and confirm that Codex mode is available."}
          </li>
          <li>
            {locale === "zh"
              ? "从本页面下载最新版 Codex Themes；不要继续使用旧安装包。"
              : "Download the latest Codex Themes from this page instead of reusing an older installer."}
          </li>
          <li>{locale === "zh" ? "Mac 打开 DMG 后将应用拖入“应用程序”；Windows 运行 EXE 完成安装。" : "On Mac, open the DMG and drag the app into Applications. On Windows, run the EXE installer."}</li>
          <li>{locale === "zh" ? "Windows 若显示 SmartScreen，请确认发布来源后选择“更多信息 → 仍要运行”。" : "If Windows SmartScreen appears, verify the source and choose More info → Run anyway."}</li>
          <li>
            {locale === "zh"
              ? "以后看到客户端更新提示请及时升级；自动更新遇到问题时，可重新下载当前系统对应的安装包覆盖安装。"
              : "Install future in-app updates promptly. If automatic updating fails, download the installer for your system and install it over the current version."}
          </li>
        </ol>
        <p>
          {locale === "zh"
            ? "Codex 界面会持续迭代，Codex Themes 也会同步提供兼容修复。遇到主题显示异常时，请先确认两边都是最新版，再重新应用主题。应用不修改 Codex 安装包，也不会读取 API Key。"
            : "Codex evolves continuously, and Codex Themes ships matching compatibility fixes. If a theme looks wrong, update both apps first and reapply the theme. Codex Themes does not patch Codex or read API keys."}
        </p>
        <a class="text-link" href={GITHUB_REPO_URL}>{locale === "zh" ? "在 GitHub 查看源码" : "View the source on GitHub"}</a>
      </div>
    </div>
  </section>
</BaseLayout>
