---
/**
 * [INPUT]: 依赖站点下载配置、Locale 与 BaseLayout
 * [OUTPUT]: 提供 Windows/macOS 下载、平台要求和首次安装说明页面
 * [POS]: Web components 的桌面客户端下载落地页
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_REPO_URL, MAC_DMG_DOWNLOAD_URL, MAC_ZIP_DOWNLOAD_URL, WINDOWS_DOWNLOAD_URL } from "../config";
import type { Locale } from "../lib/i18n";

const { locale } = Astro.props as { locale: Locale };
const description =
  locale === "zh"
    ? "下载适用于 Windows 11 x64 或 Apple 芯片 Mac 的最新版 Codex Themes，并查看平台要求、更新与首次安装说明。"
    : "Download the latest Codex Themes for Windows 11 x64 or Apple silicon Macs, with platform requirements, update, and first-run guidance.";
---

<BaseLayout locale={locale} title={locale === "zh" ? "下载" : "Download"} description={description}>
  <section class="download-page-hero section-shell">
    <div class="eyebrow">CODEX THEMES · LATEST BETA</div>
    <h1>{locale === "zh" ? "选择你的平台，然后打开一个更有趣的 Codex。" : "Choose your platform for a more personal Codex workspace."}</h1>
    <p>{description}</p>
    <div class="download-grid">
      <article class="download-card">
        <div class="download-card-main">
          <div class="platform-mark">WIN</div>
          <div>
            <h2>Windows 11 x64</h2>
            <p>{locale === "zh" ? "Windows 11 x64 · 需要 Microsoft Store 版 Codex" : "Windows 11 x64 · Microsoft Store Codex required"}</p>
          </div>
        </div>
        <div class="download-card-actions">
          <a class="button button-blue" href={WINDOWS_DOWNLOAD_URL}>{locale === "zh" ? "下载 Windows x64" : "Download for Windows"}</a>
        </div>
      </article>
      <article class="download-card">
        <div class="download-card-main">
          <div class="platform-mark">macOS</div>
          <div>
            <h2>{locale === "zh" ? "Apple 芯片版" : "Apple silicon"}</h2>
            <p>M1 / M2 / M3 / M4 · macOS 13+</p>
          </div>
        </div>
        <div class="download-card-actions">
          <a class="button button-blue" href={MAC_DMG_DOWNLOAD_URL}>{locale === "zh" ? "下载 DMG" : "Download DMG"}</a>
          <a class="text-link" href={MAC_ZIP_DOWNLOAD_URL}>{locale === "zh" ? "下载 ZIP" : "Download ZIP"}</a>
        </div>
      </article>
    </div>
    <p class="availability-note">
      {locale === "zh"
        ? "Windows 11 x64 与 Apple 芯片 Mac 均已完成运行、打包客户端和安装交付验证。Windows 10、Windows ARM64 与 Intel Mac 暂不提供安装包。"
        : "Windows 11 x64 and Apple silicon Macs have passed runtime, packaged-client, and installer delivery verification. Windows 10, Windows ARM64, and Intel Macs are not offered yet."}
    </p>
  </section>

  <section class="install-guide section-shell">
    <div class="section-kicker">{locale === "zh" ? "安装与更新" : "INSTALL & UPDATE"}</div>
    <div class="install-guide-grid">
      <h2>
        {locale === "zh"
          ? "先把 Codex 和 Codex Themes 都更新到最新版"
          : "Keep both Codex and Codex Themes up to date"}
      </h2>
      <div class="platform-install-list">
        <section class="platform-install-instructions">
          <h3>Windows 11 x64</h3>
          <ol>
            <li>{locale === "zh" ? "从 Microsoft Store 安装或更新官方 Codex，并确认可以进入 Codex 模式。" : "Install or update the official Codex app from Microsoft Store and confirm that Codex mode opens."}</li>
            <li>{locale === "zh" ? "下载最新版 Windows x64 NSIS 安装包，并确认来源为本官网或官方 GitHub Release。" : "Download the latest Windows x64 NSIS installer and confirm it came from this website or the official GitHub Release."}</li>
            <li>{locale === "zh" ? "安装器按当前用户安装，不需要管理员权限；升级和卸载会保留用户创建的主题。" : "The installer is per-user and needs no administrator access; upgrades and uninstall preserve user-created themes."}</li>
          </ol>
          <aside class="install-troubleshooting">
            <h3>{locale === "zh" ? "Windows SmartScreen 提示" : "Windows SmartScreen notice"}</h3>
            <p>{locale === "zh" ? "当前 Windows 安装包尚未完成代码签名，SmartScreen 可能显示“Windows 已保护你的电脑”。请只使用本官网或官方 GitHub Release 的安装包；核对来源后，可选择“更多信息 → 仍要运行”。生产发布需要由 CI 提供代码签名证书。" : "The current Windows installer is not code-signed, so SmartScreen may show “Windows protected your PC.” Use only this website or the official GitHub Release; after verifying the source, choose More info → Run anyway. Production releases require a CI-provided code-signing certificate."}</p>
          </aside>
        </section>

        <section class="platform-install-instructions">
          <h3>{locale === "zh" ? "macOS Apple 芯片" : "macOS Apple silicon"}</h3>
          <ol>
            <li>{locale === "zh" ? "从官方渠道安装或升级最新版 ChatGPT / Codex 桌面应用，并确认可以进入 Codex 模式。" : "Install or update the official ChatGPT / Codex desktop app and confirm that Codex mode is available."}</li>
            <li>{locale === "zh" ? "下载最新版 DMG，打开后把 Codex Themes 拖入“应用程序”。" : "Download the latest DMG, open it, and drag Codex Themes into Applications."}</li>
            <li>{locale === "zh" ? "第一次打开若被阻止，进入“系统设置 → 隐私与安全性”，选择“仍要打开”。" : "If the first launch is blocked, open System Settings → Privacy & Security and choose Open Anyway."}</li>
          </ol>
          <aside class="install-troubleshooting">
            <h3>{locale === "zh" ? "提示“Codex Themes.app 已损坏”怎么办" : "If macOS says Codex Themes.app is damaged"}</h3>
            <p>{locale === "zh" ? "当前安装包尚未完成 Apple 签名与公证。确认 DMG 来自本官网或官方 GitHub Release，并把最新版应用复制到“应用程序”后，打开“终端”执行：" : "The current build is not Apple-signed or notarized. Confirm the DMG came from this website or the official GitHub Release, copy the latest app to Applications, then open Terminal and run:"}</p>
            <pre><code>xattr -dr com.apple.quarantine "/Applications/Codex Themes.app"</code></pre>
            <p>{locale === "zh" ? "这只移除 Codex Themes 的下载隔离属性，不会全局关闭 Gatekeeper；请勿对来源不明的应用执行。" : "This removes quarantine only from Codex Themes and does not disable Gatekeeper globally. Never run it for an app from an untrusted source."}</p>
          </aside>
        </section>

        <p>{locale === "zh" ? "Codex 界面会持续迭代。遇到主题显示异常时，请先确认两个应用都是最新版，再重新应用主题。Codex Themes 不修改 Codex 安装包，也不会读取 API Key。" : "Codex evolves continuously. If a theme looks wrong, update both apps first and reapply it. Codex Themes does not patch Codex or read API keys."}</p>
        <a class="text-link" href={GITHUB_REPO_URL}>{locale === "zh" ? "在 GitHub 查看源码" : "View the source on GitHub"}</a>
      </div>
    </div>
  </section>
</BaseLayout>
