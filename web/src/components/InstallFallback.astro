---
/**
 * [INPUT]: 依赖下载页路径、Locale 与本地化路由工具
 * [OUTPUT]: 提供深链未唤起客户端时的可访问下载回退弹窗
 * [POS]: Web components 的协议启动失败恢复入口
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import { DOWNLOAD_PAGE_PATH } from "../config";
import { href, type Locale } from "../lib/i18n";
const { locale } = Astro.props as { locale: Locale };
---

<div class="install-modal-backdrop" data-install-modal hidden>
  <section class="install-modal" role="dialog" aria-modal="true" aria-labelledby="install-title">
    <button class="modal-close" type="button" aria-label={locale === "zh" ? "关闭" : "Close"} data-install-close>
      {locale === "zh" ? "关闭" : "Close"}
    </button>
    <div class="eyebrow">{locale === "zh" ? "没有打开应用？" : "Didn’t open the app?"}</div>
    <h2 id="install-title">
      {locale === "zh" ? "先安装 Codex Themes" : "Install Codex Themes first"}
    </h2>
    <p>
      {locale === "zh"
        ? "目前支持 Windows 11 x64 与 Apple 芯片 Mac。安装完成后回到这里，再点击一次即可直接定位主题。"
        : "Windows 11 x64 and Apple silicon Macs are supported. Install the app, return here, and try the theme again."}
    </p>
    <div class="modal-download-note">
      <strong>{locale === "zh" ? "Windows 与 macOS" : "Windows and macOS"}</strong>
      <span>
        {locale === "zh"
          ? "在下载页选择对应安装包，并查看当前签名与首次打开说明。"
          : "Choose your platform on the download page and review the current signing and first-launch guidance."}
      </span>
    </div>
    <div class="modal-button-row">
      <a class="button button-blue" href={href(locale, DOWNLOAD_PAGE_PATH)}>
        {locale === "zh" ? "选择安装包" : "Choose a download"}
      </a>
      <button class="button button-light" type="button" data-install-retry>
        {locale === "zh" ? "安装后重试" : "Try again"}
      </button>
    </div>
  </section>
</div>
