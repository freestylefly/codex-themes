---
import { DOWNLOAD_URL } from "../config";
import type { Locale } from "../lib/i18n";
const { locale } = Astro.props as { locale: Locale };
---

<div class="install-modal-backdrop" data-install-modal hidden>
  <section class="install-modal" role="dialog" aria-modal="true" aria-labelledby="install-title">
    <button class="modal-close" type="button" aria-label={locale === "zh" ? "关闭" : "Close"} data-install-close>
      {locale === "zh" ? "关闭" : "Close"}
    </button>
    <div class="eyebrow">{locale === "zh" ? "没有打开应用？" : "Didn’t open the app?"}</div>
    <h2 id="install-title">
      {locale === "zh" ? "先安装 Codex Themes" : "Install Codex Themes first"}
    </h2>
    <p>
      {locale === "zh"
        ? "目前支持 Apple 芯片 Mac、Intel Mac 和 Windows x64。选择对应安装包后，回到这里再次定位主题。"
        : "Apple silicon Macs, Intel Macs, and Windows x64 are supported. Choose the matching installer, then return here and try again."}
    </p>
    <div class="modal-download-note">
      <strong>{locale === "zh" ? "桌面端下载" : "Desktop download"}</strong>
      <span>
        {locale === "zh"
          ? "Windows 版本当前标记为预览版，首次安装可能需要确认 SmartScreen 提示。"
          : "The Windows build is currently a preview and may require a SmartScreen confirmation."}
      </span>
    </div>
    <div class="modal-button-row">
      <a class="button button-blue" href={DOWNLOAD_URL}>
        {locale === "zh" ? "选择安装包" : "Choose an installer"}
      </a>
      <button class="button button-light" type="button" data-install-retry>
        {locale === "zh" ? "安装后重试" : "Try again"}
      </button>
    </div>
  </section>
</div>
